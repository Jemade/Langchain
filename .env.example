# Set a random local reviewer token. Never use this placeholder as a real secret.
FREIGHTDESK_TOKEN=replace-with-random-token
FREIGHTDESK_DATA=runtime
FREIGHTDESK_MODE=demo
# Optional: pip install -e '.[bedrock]'; use an AWS role/SSO, not committed access keys.
# FREIGHTDESK_MODE=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=your-enabled-model-or-inference-profile
